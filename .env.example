# Public/mobile configuration only. Pass these using --dart-define-from-file.
SHOPIFY_STOREFRONT_DOMAIN=www.srikrishnapearls.com
SHOPIFY_SHOP_DOMAIN=srikrishnapearls.myshopify.com
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace_with_public_customer_account_client_id
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace_with_public_storefront_token
SKP_MIDDLEWARE_BASE_URL=https://shri-middleware.ekarigar.com
# Customer authentication uses the signed-in customer's OAuth token.
# Never put a shared middleware/payment API secret in the app.

# Never place the Shopify Admin API client secret in this Flutter project.
